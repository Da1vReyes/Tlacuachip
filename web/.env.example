# Base URL of the tlacuachic-server API (Overpass density + AI routes).
# Defaults to http://localhost:4000 when unset (see src/hooks/useDensity.ts).
VITE_API_URL=http://localhost:4000

# Base URL of tlacuachic-user-service (accounts, business profile, progress,
# preferences, provider profile, saved team — real Postgres persistence).
# Defaults to http://localhost:4100 when unset (see src/lib/userApi.ts).
VITE_USER_SERVICE_URL=http://localhost:4100

# Public catalog endpoint (roadmap, mentors and provider roster).
VITE_CATALOG_SERVICE_URL=http://localhost:4200
