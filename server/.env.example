# Copy to .env — it is loaded automatically by `npm run dev` / `npm start`.

# Port the API listens on. Defaults to 4000 when unset.
PORT=4000

# OpenRouter key for /api/match and /api/insights. Without it both routes
# still work using local, deterministic fallbacks (the UI says so).
# Get one at https://openrouter.ai/keys — it only ever lives on the server.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Sent as HTTP-Referer to OpenRouter (their attribution header). Optional.
OPENROUTER_REFERER=http://localhost:5173

# Browser origins allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180

# Per-IP requests per minute on the AI routes.
AI_RATE_LIMIT_PER_MINUTE=20
