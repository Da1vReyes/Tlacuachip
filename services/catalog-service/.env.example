# Copy to .env — it is loaded automatically by `npm run dev` / `npm start`.

# Port this service listens on. Defaults to 4200 when unset.
PORT=4200

# Postgres connection string. Required. Can be the SAME database as
# user-service — catalog-service uses its own tlacuachic_-prefixed tables
# and has no foreign keys into user-service's tables.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret user-service presents (x-internal-key header) when it syncs
# a real provider signup into this service's public roster. Must match the
# INTERNAL_API_KEY user-service is configured with. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# Browser origins allowed to call the public GET endpoints (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180
