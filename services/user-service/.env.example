# Copy to .env — it is loaded automatically by `npm run dev` / `npm start`.

# Port this service listens on. Defaults to 4100 when unset.
PORT=4100

# Postgres connection string. Required — the service refuses to start
# without it. Any managed Postgres works (Render, Supabase, Neon, RDS...).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signs and verifies session tokens. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it logs everyone out (all existing tokens stop verifying).
JWT_SECRET=
DEMO_ACCOUNT_EMAIL=demo@tlacuachic.local
DEMO_ACCOUNT_PASSWORD=TlacuachicDemo2026!

# Browser origins allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180

# catalog-service sync: when a provider profile is saved, this service
# calls PUT ${CATALOG_SERVICE_URL}/api/providers/:userId on catalog-service so the real
# signup appears in the public marketplace/team roster, not just privately
# in this account. Must match catalog-service's INTERNAL_API_KEY.
CATALOG_SERVICE_URL=http://localhost:4200
CATALOG_INTERNAL_API_KEY=
