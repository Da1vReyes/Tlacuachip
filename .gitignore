# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Env files (never commit secrets)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.local

# Local tooling caches
.impeccable/

# The full official DENUE import is generated locally and stays out of Git.
# The compact CDMX cafetería pilot extract is public, source-attributed data
# committed specifically so the hosted hackathon demo is not dependent on an
# external Overpass request.
server/data/*
!server/data/denue-pilot.json
